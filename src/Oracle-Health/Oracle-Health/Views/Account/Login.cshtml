@model Oracle_Health.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<section class="auth-shell">
    <div class="auth-panel">
        <div class="auth-copy">
            <p class="auth-eyebrow">Oracle Health</p>
            <h1>Sign in</h1>
            <p>Access appointments, patient records, schedules, and clinic workspaces.</p>
        </div>

        <form asp-action="Login" method="post" class="auth-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

            <div class="auth-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <label class="auth-check">
                <input asp-for="RememberMe" />
                <span>Keep me signed in</span>
            </label>

            <button type="submit" class="auth-button">Sign in</button>

            <p class="auth-switch">
                New patient?
                <a asp-controller="Account" asp-action="Register">Create an account</a>
            </p>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
