@model Oracle_Health.Models.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<section class="auth-shell">
    <div class="auth-panel">
        <div class="auth-copy">
            <p class="auth-eyebrow">Patient access</p>
            <h1>Create account</h1>
            <p>Register as a patient to view your profile and prepare for appointment services.</p>
        </div>

        <form asp-action="Register" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="auth-validation"></div>

            <div class="auth-grid">
                <div class="auth-field">
                    <label asp-for="FirstName"></label>
                    <input asp-for="FirstName" autocomplete="given-name" />
                    <span asp-validation-for="FirstName"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="LastName"></label>
                    <input asp-for="LastName" autocomplete="family-name" />
                    <span asp-validation-for="LastName"></span>
                </div>
            </div>

            <div class="auth-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Cpr"></label>
                <input asp-for="Cpr" inputmode="numeric" />
                <span asp-validation-for="Cpr"></span>
            </div>

            <div class="auth-grid">
                <div class="auth-field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" autocomplete="new-password" />
                    <span asp-validation-for="Password"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
            </div>

            <button type="submit" class="auth-button">Create account</button>

            <p class="auth-switch">
                Already registered?
                <a asp-controller="Account" asp-action="Login">Sign in</a>
            </p>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
