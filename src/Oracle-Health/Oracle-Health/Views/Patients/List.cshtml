@model IEnumerable<Oracle_Health.Models.ViewModels.PatientCardViewModel>

@{
    ViewData["Title"] = "Patients";
    var searchTerm = ViewData["SearchTerm"] as string ?? string.Empty;
}

<div class="appointments-container">
    <h1 class="main-title">All Patients</h1>
    <form asp-controller="Patients" asp-action="List" method="get" class="patient-search-form">
        <input type="text"
               id="patient-search"
               name="searchTerm"
               value="@searchTerm"
               placeholder="Search by name, CPR, or reference"
               aria-label="Search patients">
        <button type="submit">Search</button>
        @if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <a asp-controller="Patients" asp-action="List">Clear</a>
        }
    </form>
    <div class="patients-grid">
        @if (!Model.Any())
        {
            <p>@(string.IsNullOrWhiteSpace(searchTerm) ? "No patients found." : "No patients match your search.")</p>
        }
        else
        {
            @foreach (var patient in Model)
            {
                <div class="patient-card">
                    <img src="~/images/dummy-user-image.png" alt="user-image">
                    <p>@patient.FullName</p>
                    <small>Ref: @patient.PatientReference</small>
                </div>
            }
        }
    </div>
</div>
