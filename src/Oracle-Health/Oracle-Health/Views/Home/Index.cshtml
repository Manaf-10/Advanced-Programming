@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Home";
    var reportingBaseUrl = Configuration["Reporting:BaseUrl"] ?? "http://localhost:5055";
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var roleName = User.IsInRole("Clinic Manager")
        ? "Clinic Manager"
        : User.IsInRole("Receptionist")
            ? "Receptionist"
            : User.IsInRole("Doctor")
                ? "Doctor"
                : User.IsInRole("Patient")
                    ? "Patient"
                    : "Guest";
}

<section class="home-shell">
    <div class="home-header">
        <span class="auth-eyebrow">Oracle Health</span>
        <h1>Welcome@(isAuthenticated ? $", {User.Identity?.Name}" : "")</h1>
        <p>
            @(isAuthenticated
                ? $"You are signed in as {roleName}. Use the navigation to open your clinic workspace."
                : "Use public lookup to check appointment information, or sign in to access your clinic workspace.")
        </p>
    </div>

    <div class="home-actions">
        @if (isAuthenticated)
        {
            @if (User.IsInRole("Clinic Manager"))
            {
                <a href="@($"{reportingBaseUrl}/reports/statistics")" class="home-action-card">
                    <span>Reports</span>
                    <strong>Review clinic performance and appointment trends.</strong>
                </a>
                <a asp-controller="Doctor" asp-action="Index" class="home-action-card">
                    <span>Doctors</span>
                    <strong>Manage doctor profiles, workload, and schedules.</strong>
                </a>
            }
            else if (User.IsInRole("Receptionist"))
            {
                <a href="/appointments" class="home-action-card">
                    <span>Appointments</span>
                    <strong>Confirm bookings, check in patients, and monitor the queue.</strong>
                </a>
                <a asp-controller="Patients" asp-action="List" class="home-action-card">
                    <span>Patients</span>
                    <strong>Find patient records and appointment history.</strong>
                </a>
            }
            else if (User.IsInRole("Doctor"))
            {
                <a href="/doctors/me/appointments" class="home-action-card">
                    <span>My Appointments</span>
                    <strong>Open assigned appointments and complete visit records.</strong>
                </a>
                <a href="/visit-records" class="home-action-card">
                    <span>Visit Records</span>
                    <strong>Review diagnoses, notes, and prescriptions.</strong>
                </a>
            }
            else
            {
                <a href="/appointments/PatientAppointments" class="home-action-card">
                    <span>View Appointments</span>
                    <strong>View All the Apointments your Appointments.</strong>
                </a>
                <a href="/patients/history" class="home-action-card">
                    <span>Visit History</span>
                    <strong>Review your completed visits and prescriptions.</strong>
                </a>
            }
        }
        else
        {
            <a asp-controller="Lookup" asp-action="Index" class="home-action-card">
                <span>Public Lookup</span>
                <strong>Check upcoming appointments using patient reference.</strong>
            </a>
            <a asp-controller="Account" asp-action="Login" class="home-action-card">
                <span>Sign In</span>
                <strong>Access your role-based clinic tools.</strong>
            </a>
        }
    </div>
</section>
