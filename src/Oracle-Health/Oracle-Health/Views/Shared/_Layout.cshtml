<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Oracle Health</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="logo-image-container">
            <a asp-controller="Home" asp-action="Index">
                <img src="/images/logo.svg" alt="Oracle Health">
            </a>
        </div>
        <div class="notifications-image-container">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <img src="~/images/notifications-icon.png" alt="notifications">
            }
        </div>
    </header>

    <div class="main-container">
        <nav>
            @* Guest / Default Items *@
            <a asp-controller="Home" asp-action="Index">
                <img src="../images/appointments-icon.png" alt="Home">
            </a>

            @if (User.Identity?.IsAuthenticated == true)
            {
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Dashboard">Admin Tool</a>
                }

                @if (User.IsInRole("Doctor") || User.IsInRole("Reception"))
                {
                    <a asp-controller="Appointments" asp-action="Index">
                        <img src="~/images/visit-icon.png" alt="Appointments">
                    </a>
                }

                @if (User.IsInRole("Doctor") || User.IsInRole("Admin"))
                {
                    <a asp-controller="Doctor" asp-action="Index" class="nav-text-link">DR</a>
                }

                @if (User.IsInRole("Reception") || User.IsInRole("Admin"))
                {
                    <a asp-controller="Patients" asp-action="List">
                        <img src="~/images/patients.png" alt="Patients">
                    </a>
                }

                <div class="profile-section">
                    <a asp-controller="Account" asp-action="Profile" class="profile-link">
                        <img src="~/images/user-pfp.svg" alt="profile">
                    </a>
                </div>
            }
            else
            {
                @* Login link for Guests *@
                <a asp-controller="Account" asp-action="Login">Login</a>
            }
        </nav>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
