@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject Oracle_Health.Models.ClinicManagementSystemContext DbContext
@inject IConfiguration Configuration

@{
    var layoutIsAuthenticated = User.Identity?.IsAuthenticated == true;
    var layoutNotifications = new List<Oracle_Health.Models.Notification>();
    var reportingBaseUrl = Configuration["Reporting:BaseUrl"] ?? "http://localhost:5055";

    if (layoutIsAuthenticated && long.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var layoutUserId))
    {
        layoutNotifications = await DbContext.Notifications
            .AsNoTracking()
            .Where(notification => notification.UserId == layoutUserId)
            .OrderByDescending(notification => notification.CreatedAt)
            .Take(8)
            .ToListAsync();
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Oracle Health</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

</head>
<body>
    <header>
        <div class="logo-image-container">
            <a asp-controller="Home" asp-action="Index">
                <img src="/images/logo.svg" alt="Oracle Health">
            </a>
        </div>
        <div class="notifications-image-container">
            @if (layoutIsAuthenticated)
            {
                <div class="dropdown notification-dropdown">
                    <button class="notification-trigger"
                            type="button"
                            id="notificationMenuButton"
                            data-bs-toggle="dropdown"
                            data-bs-auto-close="outside"
                            aria-expanded="false"
                            title="Notifications">
                        <img src="~/images/notifications-icon.png" alt="notifications">
                        @if (layoutNotifications.Any())
                        {
                            <span class="notification-count">@layoutNotifications.Count</span>
                        }
                    </button>
                    <div class="dropdown-menu dropdown-menu-end notification-menu" aria-labelledby="notificationMenuButton">
                        <div class="notification-menu-header">
                            <strong>Notifications</strong>
                            @if (layoutNotifications.Any())
                            {
                                <form asp-controller="Notifications" asp-action="Clear" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="notification-clear-button">Clear all</button>
                                </form>
                            }
                        </div>

                        @if (!layoutNotifications.Any())
                        {
                            <p class="notification-empty">No notifications.</p>
                        }
                        else
                        {
                            <div class="notification-stack">
                                @foreach (var notification in layoutNotifications)
                                {
                                    <div class="notification-item">
                                        <div>
                                            <p>@notification.Message</p>
                                            @if (notification.CreatedAt.HasValue)
                                            {
                                                <span>@notification.CreatedAt.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                                            }
                                        </div>
                                        <form asp-controller="Notifications"
                                                asp-action="Delete"
                                                asp-route-id="@notification.Id"
                                                method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="notification-delete-button" aria-label="Delete notification">Delete</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </header>

    <div class="main-container">
        <nav>
            @{
                var isAuthenticated = layoutIsAuthenticated;
                var isPatient = User.IsInRole("Patient");
                var isDoctor = User.IsInRole("Doctor");
                var isReceptionist = User.IsInRole("Reception");
                var isClinicManager = User.IsInRole("Admin");
            }

            <a asp-controller="Home" asp-action="Index" class="nav-link-item">
                <img src="~/images/appointments-icon.png" alt="">
                <span>Home</span>
            </a>

            @if (isAuthenticated)
            {
                @if (isPatient)
                {
                    <a href="/appointments/PatientAppointments" class="nav-link-item">
                        <img src="~/images/visit-icon.png" alt="">
                        <span>My Appointments</span>
                    </a>
                    <a href="/appointments" class="nav-link-item">
                        <img src="~/images/appointments-icon.png" alt="">
                        <span>Appointments</span>
                    </a>
                    <a href="/patients/history" class="nav-link-item">
                        <img src="~/images/patients.png" alt="">
                        <span>History</span>
                    </a>
                    <a href="/patients/prescriptions" class="nav-link-item">
                        <span>Rx</span>
                        <span>Prescriptions</span>
                    </a>
                }

                @if (isDoctor)
                {
                    <a href="/doctors/me/appointments" class="nav-link-item">
                        <img src="~/images/appointments-icon.png" alt="">
                        <span>My Appointments</span>
                    </a>
                    <a href="/visit-records" class="nav-link-item">
                        <span>VR</span>
                        <span>Visit Records</span>
                    </a>
                    <a href="/patients/list" class="nav-link-item">
                        <img src="~/images/patients.png" alt="">
                        <span>Patients</span>
                    </a>
                    <a href="/doctors/me/availability" class="nav-link-item">
                        <span>AV</span>
                        <span>Availability</span>
                    </a>
                }

                @if (isReceptionist)
                {
                    <a href="/appointments/book" class="nav-link-item">
                        <img src="~/images/visit-icon.png" alt="">
                        <span>Book</span>
                    </a>
                    <a href="/appointments" class="nav-link-item">
                        <img src="~/images/appointments-icon.png" alt="">
                        <span>Appointments</span>
                    </a>
                    <a href="/appointments/live" class="nav-link-item">
                        <span>LB</span>
                        <span>Live Board</span>
                    </a>
                    <a asp-controller="Doctor" asp-action="Index" class="nav-link-item">
                        <span>DR</span>
                        <span>Doctors</span>
                    </a>
                    <a asp-controller="Patients" asp-action="List" class="nav-link-item">
                        <img src="~/images/patients.png" alt="">
                        <span>Patients</span>
                    </a>
                }

                @if (isClinicManager)
                {
                    <a asp-controller="Doctor" asp-action="Index" class="nav-link-item">
                        <span>DR</span>
                        <span>Doctors</span>
                    </a>
                    <a href="/specializations" class="nav-link-item">
                        <span>SP</span>
                        <span>Specializations</span>
                    </a>
                    <a href="/appointments" class="nav-link-item">
                        <img src="~/images/appointments-icon.png" alt="">
                        <span>Appointments</span>
                    </a>
                    <a href="/appointments/live" class="nav-link-item">
                        <span>LB</span>
                        <span>Live Board</span>
                    </a>
                    <a href="@($"{reportingBaseUrl}/reports/statistics")" class="nav-link-item">
                        <span>ST</span>
                        <span>Statistics</span>
                    </a>
                    <a href="@($"{reportingBaseUrl}/reports/doctor-workload")" class="nav-link-item">
                        <span>RW</span>
                        <span>Workload</span>
                    </a>
                    <a href="@($"{reportingBaseUrl}/reports/cancellations")" class="nav-link-item">
                        <span>RC</span>
                        <span>Cancellations</span>
                    </a>
                }

                <div class="profile-section">
                    <a asp-controller="Account" asp-action="Profile" class="nav-link-item profile-link">
                        <img src="~/images/user-pfp.svg" alt="">
                        <span>Profile</span>
                    </a>
                </div>
            }
            else
            {
                <a asp-controller="Lookup" asp-action="Index" class="nav-link-item">
                    <span>LU</span>
                    <span>Lookup</span>
                </a>
                <a asp-controller="Account" asp-action="Login" class="nav-link-item">
                    <span>IN</span>
                    <span>Log in</span>
                </a>
                <a asp-controller="Account" asp-action="Register" class="nav-link-item">
                    <span>+</span>
                    <span>Register</span>
                </a>
            }
        </nav>

        <main role="main" class="pb-3">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="page-alert page-alert-success">@successMessage</div>
            }
            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="page-alert page-alert-error">@errorMessage</div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
